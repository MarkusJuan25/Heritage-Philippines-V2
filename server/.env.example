# Server runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5174

# PostgreSQL connection (used by Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heritage_philippines_v2?schema=public

# JWT — generate strong random values in production (>=32 chars)
JWT_ACCESS_SECRET=replace-me-with-strong-random-string
JWT_REFRESH_SECRET=replace-me-with-strong-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email notifications via Resend (https://resend.com)
# Set EMAIL_NOTIFICATIONS_ENABLED=true and supply an API key to activate.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Admin recipients for quote and contact inquiry notification emails.
# CONTACT_ADMIN_EMAIL falls back to QUOTE_ADMIN_EMAIL when not set.
QUOTE_ADMIN_EMAIL=
CONTACT_ADMIN_EMAIL=

# Cloudflare Turnstile — server-side secret key only.
# Never expose TURNSTILE_SECRET_KEY to the browser or commit it to version control.
# Set TURNSTILE_ENABLED=false to bypass verification in local development.
# In production, TURNSTILE_ENABLED must be "false" or TURNSTILE_SECRET_KEY must be set.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
