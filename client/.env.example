# Vite requires the VITE_ prefix to expose vars to the client bundle.
VITE_API_BASE_URL=http://localhost:5000

# Public production origin — used to build canonical URLs and absolute social metadata URLs.
# Must not have a trailing slash.
VITE_SITE_URL=https://heritagephilippines.com

# Cloudflare Turnstile — public site key only (safe to include in the browser bundle).
# Obtain this from the Cloudflare dashboard: Turnstile → Sites → your site → Site Key.
# This is NOT the secret key. Never put TURNSTILE_SECRET_KEY here.
# Leave empty in local development when TURNSTILE_ENABLED=false on the server.
VITE_TURNSTILE_SITE_KEY=
