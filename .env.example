# Server runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL connection (used by Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heritage_v2?schema=public

# JWT — generate strong random values in production (>=32 chars)
JWT_ACCESS_SECRET=replace-me-with-strong-random-string
JWT_REFRESH_SECRET=replace-me-with-strong-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
